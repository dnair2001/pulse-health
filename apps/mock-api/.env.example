# Copy to .env and adjust. All settings use the APP_ prefix.
APP_NAME=pulse-health-api
APP_VERSION=0.1.0
# JSON array, used only when the frontend is not served through the dev proxy
APP_CORS_ORIGINS=["http://localhost:4200"]
# File-backed JSON store, relative to apps/mock-api. Deleted or missing -> reseeded.
APP_STORE_PATH=data/store.json
# Root log level for the JSON logger (DEBUG, INFO, WARNING, ERROR)
APP_LOG_LEVEL=INFO
# One JSON object per line, mirrored to stdout. Directory is created on startup.
APP_LOG_PATH=data/logs/api.log
# Span destination when no OTLP endpoint is configured
APP_TRACE_PATH=data/logs/traces.jsonl
# Set false (or OTEL_SDK_DISABLED=true) to skip OpenTelemetry entirely
APP_TRACING_ENABLED=true
# Standard OTel variable. When set, spans go to this collector instead of the file.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
