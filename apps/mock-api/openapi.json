        "properties": {
          "slotId": {
            "examples": [
              "slt_prv_001_20260804T0930"
            ],
            "title": "Slotid",
            "type": "string"
          }
        },
        "required": [
          "slotId"
        ],
        "title": "RescheduleAppointmentRequest",
        "type": "object"
      },
