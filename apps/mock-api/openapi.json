        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "ResetResponse",
        "type": "object"
      },
      "Slot": {
        "properties": {
          "endsAt": {
            "title": "Endsat",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "isBooked": {
            "default": false,
            "title": "Isbooked",
            "type": "boolean"
          },
          "providerId": {
            "title": "Providerid",
            "type": "string"
          },
          "startsAt": {
            "title": "Startsat",
            "type": "string"
          }
        },
        "required": [
          "id",
          "providerId",
          "startsAt",
          "endsAt"
        ],
        "title": "Slot",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VisitType": {
        "properties": {
          "durationMinutes": {
            "title": "Durationminutes",
            "type": "integer"
          },
          "id": {
            "$ref": "#/components/schemas/VisitTypeId"
          },
          "label": {
            "title": "Label",
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "durationMinutes"
        ],
        "title": "VisitType",
        "type": "object"
      },
      "VisitTypeId": {
        "enum": [
          "in_person",
          "video",
          "phone"
        ],
        "title": "VisitTypeId",
        "type": "string"
      }
    }
  },
