{
  "components": {
    "schemas": {
      "Appointment": {
        "properties": {
          "cancellable": {
            "title": "Cancellable",
            "type": "boolean"
          },
          "createdAt": {
            "title": "Createdat",
            "type": "string"
          },
          "endsAt": {
            "title": "Endsat",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "provider": {
            "$ref": "#/components/schemas/ProviderSummary"
          },
          "providerId": {
            "title": "Providerid",
            "type": "string"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "slotId": {
            "title": "Slotid",
            "type": "string"
          },
          "startsAt": {
            "title": "Startsat",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/AppointmentStatus"
          },
          "updatedAt": {
            "title": "Updatedat",
            "type": "string"
          },
          "visitType": {
            "$ref": "#/components/schemas/VisitTypeId"
          }
        },
        "required": [
          "id",
          "providerId",
          "provider",
          "slotId",
          "startsAt",
          "endsAt",
          "status",
          "visitType",
          "reason",
          "cancellable",
          "createdAt",
          "updatedAt"
        ],
        "title": "Appointment",
        "type": "object"
      },
      "AppointmentStatus": {
        "enum": [
          "scheduled",
          "completed",
          "cancelled"
        ],
        "title": "AppointmentStatus",
        "type": "string"
      },
      "CreateAppointmentRequest": {
        "description": "Values are validated in app.domain.rules so every message is UI-ready.",
        "properties": {
          "providerId": {
            "examples": [
              "prv_001"
            ],
            "title": "Providerid",
            "type": "string"
          },
          "reason": {
            "examples": [
              "Annual physical"
            ],
            "title": "Reason",
            "type": "string"
          },
          "slotId": {
            "examples": [
              "slt_prv_001_20260803T0900"
            ],
            "title": "Slotid",
            "type": "string"
          },
          "visitType": {
            "examples": [
              "in_person",
              "video",
              "phone"
            ],
            "title": "Visittype",
            "type": "string"
          }
        },
        "required": [
          "providerId",
          "slotId",
          "visitType",
          "reason"
        ],
        "title": "CreateAppointmentRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "time": {
            "format": "date-time",
            "title": "Time",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "time"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "Provider": {
        "properties": {
          "credentials": {
            "title": "Credentials",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "locationName": {
            "title": "Locationname",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "specialty": {
            "title": "Specialty",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "specialty",
          "credentials",
          "locationName"
        ],
        "title": "Provider",
        "type": "object"
      },
      "ProviderSummary": {
        "description": "The provider projection embedded in an appointment; omits credentials.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "locationName": {
            "title": "Locationname",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "specialty": {
            "title": "Specialty",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "specialty",
          "locationName"
        ],
        "title": "ProviderSummary",
        "type": "object"
      },
