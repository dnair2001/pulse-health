{
  "name": "portal-angular",
  "version": "0.0.0",
  "description": "Pulse Health patient portal — legacy AngularJS 1.x frontend (deliberately unmigrated). Reference implementation for the framework migration.",
  "scripts": {
    "start": "webpack serve --config webpack.config.js --mode development",
    "build": "webpack --config webpack.config.js --mode production",
    "watch": "webpack --config webpack.config.js --mode development --watch",
    "test": "karma start karma.conf.js --single-run=false",
    "test:ci": "karma start karma.conf.js --single-run --browsers=ChromeHeadlessCI",
    "lint": "eslint \"src/**/*.js\"",
    "lint:deadcode": "knip",
    "typecheck": "echo 'No TypeScript in this app (AngularJS/plain JS) — nothing to typecheck.'"
  },
  "private": true,
  "dependencies": {
    "angular": "^1.8.3",
    "angular-route": "^1.8.3",
    "angular-sanitize": "^1.8.3"
  },
  "devDependencies": {
    "angular-mocks": "^1.8.3",
    "css-loader": "^7.1.2",
    "eslint": "^8.57.0",
    "html-webpack-plugin": "^5.6.3",
    "jasmine-core": "~6.3.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "karma-webpack": "^5.0.1",
    "knip": "^6.31.0",
    "puppeteer": "^25.7.0",
    "sass": "^1.83.0",
    "sass-loader": "^16.0.4",
    "style-loader": "^4.0.0",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.0"
  }
}
