{
  "root": true,
  "ignorePatterns": ["projects/**/*"],
  "overrides": [
    {
      "files": ["*.ts"],
      "extends": [
        "eslint:recommended",
        "plugin:@typescript-eslint/recommended",
        "plugin:@angular-eslint/recommended",
        "plugin:@angular-eslint/template/process-inline-templates"
      ],
      "rules": {
        "@angular-eslint/directive-selector": [
          "error",
          {
            "type": "attribute",
            "prefix": ["app", "ph"],
            "style": "camelCase"
          }
        ],
        "@angular-eslint/component-selector": [
          "error",
          {
            "type": "element",
            "prefix": ["app", "ph"],
            "style": "kebab-case"
          }
        ],
        // Measured baseline (`ng lint` with these three rules at threshold 1, non-spec .ts
        // only): the worst offender is AppointmentsService at complexity 7, nesting depth 2,
        // 34 lines-per-function. Thresholds sit a bit above that measured max so one new
        // branch doesn't fail the build, without leaving the check meaningless.
        "complexity": ["warn", 10],
        "max-depth": ["warn", 3],
        "max-lines-per-function": ["warn", 40]
      }
    },
    {
      // Jasmine describe/it/beforeEach callbacks routinely exceed these thresholds for
      // reasons unrelated to production code quality (setup boilerplate, assertion chains,
      // not decision branching), so the rules are scoped to non-spec source.
      "files": ["*.spec.ts"],
      "rules": {
        "complexity": "off",
        "max-depth": "off",
        "max-lines-per-function": "off"
      }
    },
    {
      "files": ["*.html"],
      "extends": [
        "plugin:@angular-eslint/template/recommended",
        "plugin:@angular-eslint/template/accessibility"
      ],
      "rules": {}
    }
  ]
}
