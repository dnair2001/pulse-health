{
  "root": true,
  "env": {
    "browser": true,
    "es2021": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "extends": ["eslint:recommended"],
  "globals": {
    "angular": "readonly"
  },
  "ignorePatterns": ["dist/**/*", "node_modules/**/*"],
  "overrides": [
    {
      "files": ["*.js"],
      "rules": {
        // Measured baseline for this app's non-spec source; thresholds sit a bit above the
        // worst measured offender so one new branch doesn't fail the build, without leaving
        // the check meaningless.
        "complexity": ["warn", 10],
        "max-depth": ["warn", 3],
        "max-lines-per-function": ["warn", 45]
      }
    },
    {
      // Jasmine describe/it/beforeEach callbacks routinely exceed these thresholds for
      // reasons unrelated to production code quality (setup boilerplate, assertion chains,
      // not decision branching), so the rules are scoped to non-spec source.
      "files": ["*.spec.js"],
      "env": { "jasmine": true },
      "globals": {
        "inject": "readonly"
      },
      "rules": {
        "complexity": "off",
        "max-depth": "off",
        "max-lines-per-function": "off"
      }
    },
    {
      "files": ["webpack.config.js", "karma.conf.js"],
      "env": { "node": true },
      "parserOptions": { "sourceType": "script" }
    },
    {
      // `require.context` is webpack's build-time module-globbing API, injected only into
      // bundles it compiles itself — not a real Node/CommonJS `require`.
      "files": ["src/test-index.js"],
      "globals": { "require": "readonly" }
    }
  ]
}
