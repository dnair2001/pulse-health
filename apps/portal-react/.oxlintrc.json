{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    // Measured baseline (`npx oxlint src` with these three rules at threshold 1): the worst
    // offenders are the schedule/reschedule/list page components -- complexity 29, 25, 19 and
    // 229/179/163 lines respectively -- because each owns a whole form's validation, mutation
    // and error-display branching in one component, matching Angular's equivalent page classes.
    // Thresholds sit just above that measured max so one new branch doesn't fail the build,
    // without leaving the check meaningless.
    "eslint/complexity": ["warn", 30],
    "eslint/max-depth": ["warn", 4],
    "eslint/max-lines-per-function": ["warn", 230]
  },
  "overrides": [
    {
      // Vitest describe/it callbacks routinely exceed these thresholds for reasons unrelated to
      // production code quality (long assertion chains, not decision branching), so the rules
      // are scoped to non-test source.
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "eslint/complexity": "off",
        "eslint/max-depth": "off",
        "eslint/max-lines-per-function": "off"
      }
    }
  ]
}
